# Copy this file to frontend/.env and fill in the values. Never commit .env.
# Every VITE_* value is bundled into browser code, so only put public values here.

# Base URL of the FastAPI backend (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# Supabase project URL and anon (public) key, from Supabase Dashboard > Project Settings > API.
# The anon key is designed to be public. Never put the service-role key in the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
