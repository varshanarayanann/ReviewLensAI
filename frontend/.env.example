# Copy this file to frontend/.env and fill in the values. Never commit .env.
# Every VITE_* value is bundled into browser code, so only put public values here.

# Base URL of the FastAPI backend (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# Supabase project URL and anon (public) key, from Supabase Dashboard > Project Settings > API.
# The anon (or sb_publishable_...) key is designed to be public. Never put the service-role
# (or sb_secret_...) key in the frontend: the app refuses to start if it detects one.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
