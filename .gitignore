# Environment files hold real configuration and secrets. Never commit them;
# commit .env.example templates instead.
.env
.env.*
!.env.example

# Node / frontend
node_modules/
dist/
dist-ssr/
*.local
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python / backend
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
