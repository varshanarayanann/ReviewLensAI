# Copy this file to backend/.env and fill in the values. Never commit .env.
# Everything here is server-side only and must never be exposed to the frontend.

# local | test | production
ENVIRONMENT=local

# Postgres connection string (contains the database password - secret).
# Supabase Dashboard > Connect > Connection string (Session pooler), with your DB password filled in.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:5432/postgres

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Supabase project URL (public). The backend verifies login tokens against this
# project's public signing keys; no Supabase secret is needed.
# Supabase Dashboard > Project Settings > API > Project URL.
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase publishable (or legacy anon) key - public, same value as the frontend's
# VITE_SUPABASE_ANON_KEY. Used to ask Supabase Auth whether a login session is still
# active, so tokens stop working right after logout. Never use the sb_secret_ key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional OpenAI key enables review-grounded Q&A. Never expose it to the frontend.
# OPENAI_API_KEY=your-openai-api-key

# Optional: use another Responses-API-compatible provider instead of OpenAI.
# OPENAI_API_KEY then holds that provider's key. Example for xAI Grok:
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-4.7

# Optional: enable direct Google Maps collection via Apify's Compass review actor.
# APIFY_API_TOKEN=your-apify-token
# REVIEW_MAX_PER_RUN=20
# Maximum provider charge per run in USD (does not include previous runs).
# REVIEW_MAX_CHARGE_USD=0.10
