# Copy this file to backend/.env and fill in the values. Never commit .env.
# Everything here is server-side only and must never be exposed to the frontend.

# local | test | production
ENVIRONMENT=local

# Postgres connection string. For the team's Supabase project:
# Supabase Dashboard > Connect > Connection string (Session pooler), with your DB password filled in.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:5432/postgres

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
